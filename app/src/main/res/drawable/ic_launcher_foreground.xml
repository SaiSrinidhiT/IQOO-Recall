<?xml version="1.0" encoding="utf-8"?>
<!-- The art is a pre-rendered rounded-square icon with its own white card and shadow; inset it so
     the adaptive-icon mask (circle/squircle/rounded-square, varies by launcher) frames it rather than
     cropping into the card's corners. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_art"
    android:insetLeft="14%"
    android:insetTop="14%"
    android:insetRight="14%"
    android:insetBottom="14%" />
